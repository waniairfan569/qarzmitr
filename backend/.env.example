# Alibaba Cloud integrations (used by later implementation tasks)
DASHSCOPE_API_KEY=
# OpenAI-compatible base URL, ending in /compatible-mode/v1
# Leave blank to use Alibaba's public endpoint (dashscope-intl.aliyuncs.com)
DASHSCOPE_BASE_URL=
# All four OSS values are required together. Leave any blank to store
# ledger images on local disk instead (fine for demos).
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
# Bucket region, e.g. ap-southeast-1 or oss-ap-southeast-1
OSS_REGION=

# SQLite file path, resolved from the backend directory
DATABASE_URL=./data/qarzmitr.sqlite

# Google sign-in. All three are required together; leave blank to disable the
# button and run on email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# How long a password reset link stays valid
PASSWORD_RESET_TTL_MINUTES=30

# Email delivery for password reset links. Leave SMTP_HOST blank to print the
# link to the server log instead of sending it (fine for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465, false for 587 with STARTTLS
SMTP_SECURE=false
MAIL_FROM=QarzMitr <no-reply@qarzmitr.local>

# React frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Replace with a long, random secret before starting the server
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000